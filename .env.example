# Postgres for anything shared; leave unset to use embedded PGlite in .data/
# DATABASE_URL=postgres://writ:writ@localhost:5432/writ

# Required in production: 32+ random characters (openssl rand -base64 32)
# WRIT_SECRET=

# Where people open the console. Agents connect to <PUBLIC_URL>/mcp.
PUBLIC_URL=http://localhost:3000

# Allow more accounts after the owner's.
# ALLOW_SIGNUP=false

# How long a call waits for a decision before the agent is told to retry (max 240).
# WRIT_APPROVAL_WAIT_SECONDS=120
# How long a pending or approved call stays valid.
# WRIT_APPROVAL_TTL_HOURS=24
