{
  "name": "writ",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun run --filter '@writ/gateway' dev & bun run --filter '@writ/console' dev",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '@writ/console' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --filter '@writ/store' generate",
    "demo:upstream": "bun examples/demo-upstream.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "typescript": "6.0.3",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  }
}
